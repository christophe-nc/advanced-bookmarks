    <property>
      <code>define('advanced-bookmarks-star-messages', {
  prefix: 'advancedbookmarks.',
  keys: [
    'star.add',
    'star.remove',
    'star.added',
    'star.removed',
    'error.forbidden',
    'error.invalidToken',
    'error.methodNotAllowed',
    'error.invalid',
    'error.conflict',
    'error.storageError',
    'error.unavailable',
    'error.unknownOperation',
    'error.network'
  ]
});
require(['jquery', 'xwiki-meta', 'xwiki-l10n!advanced-bookmarks-star-messages'], function($, xm, l10n) {
  'use strict';

  var serviceReference = XWiki.Model.resolve('AdvancedBookmarks.Code.Service', XWiki.EntityType.DOCUMENT);
  var serviceURL = new XWiki.Document(serviceReference).getURL('get');

  var displayState = function(button, bookmarked) {
    var label = l10n.get(bookmarked ? 'star.remove' : 'star.add');
    button.toggleClass('advanced-bookmarks-star-active', bookmarked);
    button.attr({'aria-pressed': String(bookmarked), 'title': label});
    // The label is plain text: never inject it as HTML.
    button.find('.sr-only').text(label);
  };

  var errorMessage = function(xhr) {
    var error = xhr &amp;&amp; xhr.responseJSON &amp;&amp; xhr.responseJSON.error;
    return l10n.get('error.' + (error || 'network'));
  };

  $(document).on('click', '.advanced-bookmarks-star', function(event) {
    event.preventDefault();
    var button = $(this);
    if (button.prop('disabled')) {
      return;
    }
    // Prevent concurrent toggles from a double click.
    button.prop('disabled', true);
    $.post(serviceURL, {
      'operation': 'toggle',
      'page': button.attr('data-page'),
      'form_token': xm.form_token
    }).then(function(result) {
      displayState(button, result.bookmarked === true);
      new XWiki.widgets.Notification(l10n.get(result.bookmarked ? 'star.added' : 'star.removed'), 'done');
    }, function(xhr) {
      new XWiki.widgets.Notification(errorMessage(xhr), 'error');
    }).always(function() {
      button.prop('disabled', false);
    });
  });
});
