      <content>{{velocity}}
## The star is only offered to logged-in users viewing an existing page, outside of the extension's own pages
## (the AdvancedBookmarks space and the panel, which lives in the Panels space by XWiki convention).
#set ($isExtensionSpace = $doc.documentReference.spaceReferences.get(0).name == 'AdvancedBookmarks')
#set ($isExtensionPage = $isExtensionSpace || $doc.fullName == 'Panels.MyBookmarks')
#set ($isViewedPage = $xcontext.action == 'view' &amp;&amp; !$doc.isNew())
#if ($xcontext.userReference &amp;&amp; $isViewedPage &amp;&amp; !$isExtensionPage &amp;&amp; $services.advancedbookmarks)
  #set ($pageReference = $services.model.serialize($doc.documentReference, 'default'))
  #set ($state = $services.advancedbookmarks.isBookmarked($pageReference))
  ## When the bookmarks cannot be read, no star is displayed rather than a misleading one.
  #if ($state.status == 200)
    #set ($discard = $xwiki.jsx.use('AdvancedBookmarks.Code.StarUIX'))
    #set ($discard = $xwiki.ssx.use('AdvancedBookmarks.Code.StarUIX'))
    #if ($state.bookmarked)
      #set ($starLabel = $services.localization.render('advancedbookmarks.star.remove'))
      #set ($starClass = 'advanced-bookmarks-star advanced-bookmarks-star-active')
    #else
      #set ($starLabel = $services.localization.render('advancedbookmarks.star.add'))
      #set ($starClass = 'advanced-bookmarks-star')
    #end
{{html clean="false"}}
&lt;li class="btn-group" id="tmAdvancedBookmarks"&gt;
  &lt;button type="button" class="btn btn-default $starClass" title="$escapetool.xml($starLabel)"
    aria-pressed="$state.bookmarked" data-page="$escapetool.xml($pageReference)"&gt;
    $services.icon.renderHTML('star')
    &lt;span class="sr-only"&gt;$escapetool.xml($starLabel)&lt;/span&gt;
  &lt;/button&gt;
&lt;/li&gt;
{{/html}}
  #end
#end
{{/velocity}}
</content>
