    <property>
      <code>/* An empty star is shown dimmed; a bookmarked page gets a full, coloured star. The opacity also applies to image
   icon themes such as Silk, where the colour has no effect. */
.advanced-bookmarks-star .fa,
.advanced-bookmarks-star img {
  opacity: .45;
  transition: opacity .2s ease-in-out;
}

.advanced-bookmarks-star:hover .fa,
.advanced-bookmarks-star:focus .fa,
.advanced-bookmarks-star:hover img,
.advanced-bookmarks-star:focus img,
.advanced-bookmarks-star-active .fa,
.advanced-bookmarks-star-active img {
  opacity: 1;
}

.advanced-bookmarks-star-active .fa {
  color: #e6a700;
}
</code>
