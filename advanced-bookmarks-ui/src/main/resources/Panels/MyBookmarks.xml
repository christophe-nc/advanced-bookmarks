    <property>
      <content>{{velocity}}
#if ($xcontext.userReference)
  #set ($discard = $xwiki.ssx.use('Panels.MyBookmarks'))
  #if ($services.advancedbookmarks)
    #set ($panel = $services.advancedbookmarks.getPanel())
  #else
    #set ($panel = {'status': 503, 'error': 'unavailable'})
  #end
## The panel header and footer produce wiki syntax: they must stay outside of the HTML macro.
#panelheader($services.localization.render('advancedbookmarks.panel.title'))
{{html clean="false"}}
#if ($panel.status != 200)
  &lt;p class="advanced-bookmarks-panel-message"&gt;$escapetool.xml($services.localization.render("advancedbookmarks.error.$panel.error"))&lt;/p&gt;
#elseif ($panel.bookmarks.isEmpty())
  &lt;p class="advanced-bookmarks-panel-message"&gt;$escapetool.xml($services.localization.render('advancedbookmarks.panel.empty'))&lt;/p&gt;
#else
  &lt;ul class="advanced-bookmarks-panel-list"&gt;
  #foreach ($bookmark in $panel.bookmarks)
    #set ($text = "$!bookmark.label")
    #if (!$bookmark.viewable)
      ## Nothing is revealed about a page the current user cannot view: no link, no title.
      #if ($text == '')
        #set ($text = $services.localization.render('advancedbookmarks.panel.inaccessible'))
      #end
    &lt;li&gt;&lt;span class="advanced-bookmarks-panel-inaccessible" title="$escapetool.xml($services.localization.render('advancedbookmarks.panel.inaccessible'))"&gt;$escapetool.xml($text)&lt;/span&gt;&lt;/li&gt;
    #else
      ## Without label, the service gives the title of the page, or its name.
      #if ($text == '')
        #set ($text = "$!bookmark.title")
      #end
      #if ($bookmark.exists)
    &lt;li&gt;&lt;a href="$escapetool.xml($bookmark.url)"&gt;$escapetool.xml($text)&lt;/a&gt;&lt;/li&gt;
      #else
    &lt;li&gt;&lt;del class="advanced-bookmarks-panel-deleted" title="$escapetool.xml($services.localization.render('advancedbookmarks.panel.deleted'))"&gt;$escapetool.xml($text)&lt;/del&gt;&lt;/li&gt;
      #end
    #end
  #end
  &lt;/ul&gt;
#end
  &lt;p class="advanced-bookmarks-panel-all"&gt;&lt;a href="$escapetool.xml($xwiki.getURL('AdvancedBookmarks.WebHome'))"&gt;$escapetool.xml($services.localization.render('advancedbookmarks.panel.viewAll'))&lt;/a&gt;&lt;/p&gt;
{{/html}}
#panelfooter()
#end
{{/velocity}}
</content>
